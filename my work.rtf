// GET ALL UNIQUE CATEGORIES\par
export const getCategories = async (req, res) => \{\par
  try \{\par
    // NEW: Safer way to get categories without using groupBy\par
    const products = await prisma.product.findMany(\{\par
      select: \{ category: true \}\par
    \});\par
    \par
    // Extract categories and remove duplicates\par
    const uniqueCategories = [...new Set(products.map(p => p.category))];\par
    \par
    res.status(200).json(uniqueCategories);\par
  \} catch (error) \{\par
    console.log("THE EXACT ERROR IS:", error);\par
    res.status(500).json(\{ message: 'Server error', error: error.message \});\par
  \}\par
\};\par
